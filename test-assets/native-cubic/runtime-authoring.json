{
  "schema_version": 1,
  "animation": {
    "initial_state": "native_cubic:wave",
    "states": {
      "native_cubic:wave": {
        "clip": "EaseWave",
        "loop": true,
        "speed": 1,
        "events": [
          {
            "marker": "Apex",
            "event": "native_cubic:apex"
          }
        ]
      },
      "native_cubic:once": {
        "clip": "EaseWave",
        "loop": false,
        "speed": 1,
        "next": "native_cubic:wave",
        "blend_seconds": 0.1
      }
    }
  },
  "sockets": {
    "native_cubic:tip": {
      "node": "CubicRoot/CubicRig/Base/Tip"
    }
  }
}
