{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LIy-hub/BlendLib-Public/schemas/blendlib-locomotion-rules-v1.schema.json",
  "title": "BlendLib locomotion rules v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "default",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "default": {
      "type": "string"
    },
    "minimum_interval_ticks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200,
      "default": 0
    },
    "rules": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "animation",
          "conditions"
        ],
        "properties": {
          "animation": {
            "type": "string"
          },
          "conditions": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "input",
                    "equals"
                  ],
                  "properties": {
                    "input": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                    },
                    "equals": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "input",
                    "enter_min",
                    "exit_min"
                  ],
                  "properties": {
                    "input": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                    },
                    "enter_min": {
                      "type": "number"
                    },
                    "exit_min": {
                      "type": "number"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "input",
                    "enter_max",
                    "exit_max"
                  ],
                  "properties": {
                    "input": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                    },
                    "enter_max": {
                      "type": "number"
                    },
                    "exit_max": {
                      "type": "number"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
